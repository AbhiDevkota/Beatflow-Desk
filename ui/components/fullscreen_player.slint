// BeatFlow Fullscreen Player Overlay

import { Tokens } from "../tokens.slint";
import {
    PlayIcon, PauseIcon, ForwardIcon, BackwardIcon, ShuffleIcon,
    RepeatIcon, RepeatOneIcon, StarIcon, StarFilledIcon, LyricsIcon,
    UpNextIcon, VolumeIcon, VolumeMuteIcon, ChevronDownIcon
} from "../icons.slint";
import { LyricLineData } from "side_panel.slint";

export component FullScreenPlayer inherits Rectangle {
    in-out property <bool> is-open: false;
    in-out property <bool> is-playing: false;
    in-out property <bool> is-shuffle: false;
    in-out property <int> repeat-mode: 0;
    in-out property <bool> is-favorite: false;
    in-out property <float> volume-level: 0.8;

    in-out property <string> track-title: "Not Playing";
    in-out property <string> artist-name: "BeatFlow";
    in-out property <string> album-title: "";
    in-out property <string> quality-badge: "Lossless";
    in-out property <float> progress-ratio: 0.0;
    in-out property <string> time-elapsed: "0:00";
    in-out property <string> time-remaining: "-0:00";
    in-out property <image> artwork-image;
    in-out property <bool> has-artwork: false;

    in-out property <bool> show-lyrics: false;
    in-out property <[LyricLineData]> lyrics-lines: [];

    callback collapse();
    callback toggle-play();
    callback next-track();
    callback previous-track();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-favorite();
    callback toggle-lyrics();
    callback set-volume(float);
    callback seek(float);
    callback seek-lyric-time(int);

    background: #0c0c0e;
    clip: true;

    // Ambient glow layer behind artwork
    Rectangle {
        x: parent.width * 0.15;
        y: parent.height * 0.15;
        width: parent.width * 0.7;
        height: parent.height * 0.7;
        border-radius: parent.width * 0.35;
        background: #fa233b18;
    }

    VerticalLayout {
        padding-top: 16px;
        padding-bottom: 28px;
        padding-left: 36px;
        padding-right: 36px;
        spacing: 16px;

        // Header: Collapse Button & Tools
        HorizontalLayout {
            alignment: space-between;

            // Collapse Button
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: collapse_touch.has-hover ? #ffffff22 : transparent;

                ChevronDownIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-color: #ffffff;
                    width: 20px;
                    height: 20px;
                }

                collapse_touch := TouchArea {
                    clicked => { root.collapse(); }
                }
            }

            // Quality Badge & Right Tools
            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                if root.quality-badge != "": Rectangle {
                    height: 24px;
                    border-radius: 12px;
                    background: #ffffff18;
                    border-color: #ffffff22;
                    border-width: 1px;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: root.quality-badge;
                            color: Tokens.accent;
                            font-size: 11px;
                            font-weight: Tokens.font-weight-bold;
                            vertical-alignment: center;
                        }
                    }
                }

                // Lyrics Toggle
                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: root.show-lyrics ? Tokens.accent : (fs_lyrics_touch.has-hover ? #ffffff22 : transparent);

                    LyricsIcon {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        icon-color: #ffffff;
                        width: 18px;
                        height: 18px;
                    }

                    fs_lyrics_touch := TouchArea {
                        clicked => { root.toggle-lyrics(); }
                    }
                }
            }
        }

        // Main Center Area (Artwork + Metadata / Lyrics)
        HorizontalLayout {
            alignment: center;
            spacing: 48px;

            // Left / Artwork Column
            VerticalLayout {
                alignment: center;
                spacing: 24px;
                max-width: 480px;

                // Big Album Artwork
                big_art := Rectangle {
                    width: 380px;
                    height: 380px;
                    border-radius: Tokens.radius-xl;
                    background: #1e1e24;
                    drop-shadow-blur: 40px;
                    drop-shadow-color: #000000aa;
                    drop-shadow-offset-y: 20px;
                    clip: true;

                    if root.has-artwork: Image {
                        source: root.artwork-image;
                        width: 100%;
                        height: 100%;
                    }

                    if !root.has-artwork: Rectangle {
                        background: #2a2a34;
                        Text {
                            text: "♫";
                            color: Tokens.text-tertiary;
                            font-size: 80px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }

                // Track Title & Artist
                VerticalLayout {
                    alignment: start;
                    spacing: 4px;

                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: root.track-title;
                            color: #ffffff;
                            font-size: 24px;
                            font-weight: Tokens.font-weight-bold;
                            overflow: elide;
                            max-width: 320px;
                        }

                        // Favorite star
                        Rectangle {
                            width: 32px;
                            height: 32px;

                            if !root.is-favorite: StarIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                icon-color: #ffffffaa;
                                width: 22px;
                                height: 22px;
                            }

                            if root.is-favorite: StarFilledIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                icon-color: Tokens.accent-gold;
                                width: 22px;
                                height: 22px;
                            }

                            TouchArea {
                                clicked => { root.toggle-favorite(); }
                            }
                        }
                    }

                    Text {
                        text: root.artist-name;
                        color: #ffffffaa;
                        font-size: 16px;
                        font-weight: Tokens.font-weight-medium;
                        overflow: elide;
                    }
                }

                // Scrubber Bar
                VerticalLayout {
                    spacing: 6px;

                    fs_scrub_box := Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: #ffffff26;

                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width * root.progress-ratio;
                            height: parent.height;
                            border-radius: 3px;
                            background: #ffffff;
                        }

                        fs_scrub_touch := TouchArea {
                            x: 0;
                            y: -10px;
                            width: parent.width;
                            height: parent.height + 20px;

                            clicked => {
                                root.seek(clamp(self.mouse-x / parent.width, 0.0, 1.0));
                            }
                            moved => {
                                if self.pressed {
                                    root.seek(clamp(self.mouse-x / parent.width, 0.0, 1.0));
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;

                        Text {
                            text: root.time-elapsed;
                            color: #ffffff66;
                            font-size: 12px;
                        }

                        Text {
                            text: root.time-remaining;
                            color: #ffffff66;
                            font-size: 12px;
                        }
                    }
                }

                // Transport Controls
                HorizontalLayout {
                    alignment: space-between;
                    padding-left: 20px;
                    padding-right: 20px;

                    // Shuffle
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;

                        ShuffleIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            icon-color: root.is-shuffle ? Tokens.accent : #ffffff88;
                            width: 22px;
                            height: 22px;
                        }

                        TouchArea { clicked => { root.toggle-shuffle(); } }
                    }

                    // Backward
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 22px;

                        BackwardIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            icon-color: #ffffff;
                            width: 28px;
                            height: 28px;
                        }

                        TouchArea { clicked => { root.previous-track(); } }
                    }

                    // Play / Pause prominent button
                    Rectangle {
                        width: 64px;
                        height: 64px;
                        border-radius: 32px;
                        background: #ffffff;

                        if !root.is-playing: PlayIcon {
                            x: (parent.width - self.width) / 2 + 2px;
                            y: (parent.height - self.height) / 2;
                            icon-color: #000000;
                            width: 32px;
                            height: 32px;
                        }

                        if root.is-playing: PauseIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            icon-color: #000000;
                            width: 32px;
                            height: 32px;
                        }

                        TouchArea { clicked => { root.toggle-play(); } }
                    }

                    // Forward
                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 22px;

                        ForwardIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            icon-color: #ffffff;
                            width: 28px;
                            height: 28px;
                        }

                        TouchArea { clicked => { root.next-track(); } }
                    }

                    // Repeat
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        border-radius: 18px;

                        if root.repeat-mode != 2: RepeatIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            icon-color: root.repeat-mode == 1 ? Tokens.accent : #ffffff88;
                            width: 22px;
                            height: 22px;
                        }

                        if root.repeat-mode == 2: RepeatOneIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            icon-color: Tokens.accent;
                            width: 22px;
                            height: 22px;
                        }

                        TouchArea { clicked => { root.cycle-repeat(); } }
                    }
                }

                // Volume Bar
                HorizontalLayout {
                    spacing: 14px;
                    alignment: center;

                    VolumeIcon {
                        icon-color: #ffffff66;
                        width: 16px;
                        height: 16px;
                        y: (parent.height - self.height) / 2;
                    }

                    Rectangle {
                        width: 180px;
                        height: 4px;
                        border-radius: 2px;
                        background: #ffffff26;
                        y: (parent.height - self.height) / 2;

                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width * root.volume-level;
                            height: parent.height;
                            border-radius: 2px;
                            background: #ffffff;
                        }

                        fs_vol_touch := TouchArea {
                            x: 0;
                            y: -8px;
                            width: parent.width;
                            height: parent.height + 16px;

                            clicked => {
                                root.set-volume(clamp(self.mouse-x / parent.width, 0.0, 1.0));
                            }
                            moved => {
                                if self.pressed {
                                    root.set-volume(clamp(self.mouse-x / parent.width, 0.0, 1.0));
                                }
                            }
                        }
                    }

                    VolumeIcon {
                        icon-color: #ffffffaa;
                        width: 20px;
                        height: 20px;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }

            // Dual Pane: Side Lyrics (when toggled on)
            if root.show-lyrics: Rectangle {
                width: 360px;
                border-radius: Tokens.radius-large;
                background: #16161acc;
                border-color: #ffffff14;
                border-width: 1px;
                clip: true;

                VerticalLayout {
                    padding: 20px;
                    spacing: 12px;

                    Text {
                        text: "Lyrics";
                        color: #ffffff;
                        font-size: 18px;
                        font-weight: Tokens.font-weight-bold;
                    }

                    if root.lyrics-lines.length > 0: Flickable {
                        content-height: root.lyrics-lines.length * 48px;

                        VerticalLayout {
                            spacing: 10px;

                            for line[idx] in root.lyrics-lines: Rectangle {
                                height: 42px;
                                border-radius: 6px;
                                background: line.is_active ? #ffffff1c : transparent;

                                Text {
                                    text: line.text;
                                    color: line.is_active ? #ffffff : #ffffff55;
                                    font-size: line.is_active ? 18px : 15px;
                                    font-weight: line.is_active ? Tokens.font-weight-bold : Tokens.font-weight-medium;
                                    vertical-alignment: center;
                                    x: 10px;
                                }

                                TouchArea {
                                    clicked => { root.seek-lyric-time(line.time_ms); }
                                }
                            }
                        }
                    }

                    if root.lyrics-lines.length == 0: Rectangle {
                        Text {
                            text: "No lyrics available.";
                            color: Tokens.text-tertiary;
                            font-size: 14px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                }
            }
        }
    }
}
