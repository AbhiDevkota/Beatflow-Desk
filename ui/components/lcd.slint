// BeatFlow Player Bar LCD Component

import { Tokens } from "../tokens.slint";
import { MaximizeIcon } from "../icons.slint";

export component LcdDisplay inherits Rectangle {
    in-out property <string> track-title: "Not Playing";
    in-out property <string> artist-name: "BeatFlow";
    in-out property <string> album-title: "";
    in-out property <string> quality-badge: "Lossless";
    in-out property <float> progress-ratio: 0.0; // 0.0 to 1.0
    in-out property <string> time-elapsed: "0:00";
    in-out property <string> time-remaining: "-0:00";
    in-out property <image> artwork-image;
    in-out property <bool> has-artwork: false;
    in-out property <bool> is-playing: false;

    callback expand-fullscreen();
    callback seek(float); // target ratio 0.0 to 1.0

    height: 44px;
    border-radius: Tokens.radius-medium;
    background: Tokens.lcd-bg;
    border-color: Tokens.lcd-border;
    border-width: 1px;
    clip: true;

    HorizontalLayout {
        padding-left: 5px;
        padding-right: 8px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 10px;

        // Artwork Thumbnail
        art_box := Rectangle {
            width: 34px;
            height: 34px;
            border-radius: Tokens.radius-small;
            background: #2a2a30;
            clip: true;

            if root.has-artwork: Image {
                source: root.artwork-image;
                width: 100%;
                height: 100%;
            }

            if !root.has-artwork: Rectangle {
                background: #33333d;
                Text {
                    text: "♫";
                    color: Tokens.text-tertiary;
                    font-size: 14px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            // Hover overlay with maximize glyph
            if art_touch.has-hover: Rectangle {
                background: #00000088;
                MaximizeIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 12px;
                    height: 12px;
                    icon-color: #ffffff;
                }
            }

            art_touch := TouchArea {
                clicked => { root.expand-fullscreen(); }
            }
        }

        // Title, Artist, and Scrubber
        VerticalLayout {
            alignment: space-between;

            // Track Title & Quality badge
            HorizontalLayout {
                spacing: 6px;
                alignment: start;

                Text {
                    text: root.track-title;
                    color: Tokens.text-primary;
                    font-size: Tokens.font-size-body;
                    font-weight: Tokens.font-weight-semibold;
                    overflow: elide;
                    vertical-alignment: center;
                }

                if root.quality-badge != "": Rectangle {
                    height: 14px;
                    border-radius: 3px;
                    background: Tokens.nav-item-selected;
                    border-color: Tokens.border-subtle;
                    border-width: 0.5px;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        Text {
                            text: root.quality-badge;
                            color: Tokens.accent;
                            font-size: 9px;
                            font-weight: Tokens.font-weight-bold;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Artist and time
            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: root.artist-name;
                    color: Tokens.text-secondary;
                    font-size: Tokens.font-size-caption;
                    overflow: elide;
                }

                if scrubber_touch.has-hover: HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.time-elapsed;
                        color: Tokens.text-tertiary;
                        font-size: Tokens.font-size-small;
                    }
                    Text {
                        text: root.time-remaining;
                        color: Tokens.text-tertiary;
                        font-size: Tokens.font-size-small;
                    }
                }
            }
        }
    }

    // Scrubber track along bottom of LCD
    Rectangle {
        y: parent.height - (scrubber_touch.has-hover ? 4px : 2px);
        x: 0;
        width: parent.width;
        height: scrubber_touch.has-hover ? 4px : 2px;
        background: Tokens.scrubber-track;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * root.progress-ratio;
            height: parent.height;
            background: scrubber_touch.has-hover ? Tokens.accent : Tokens.scrubber-fill;
        }

        scrubber_touch := TouchArea {
            x: 0;
            y: -10px;
            width: parent.width;
            height: parent.height + 15px;

            clicked => {
                root.seek(clamp(self.mouse-x / parent.width, 0.0, 1.0));
            }
            moved => {
                if self.pressed {
                    root.seek(clamp(self.mouse-x / parent.width, 0.0, 1.0));
                }
            }
        }
    }
}
