// Search page, ported from web/app/src/pages/SearchPage.tsx.
// Results are populated from Rust via the `results` model property.

import { Theme } from "theme.slint";
import { AppIcon } from "icons.slint";
import { ListView } from "std-widgets.slint";

export struct SearchResult {
    title: string,
    artist: string,
    video-id: string,
}

export component SearchPage inherits Rectangle {
    // Bound from Rust: the list of search results.
    in property <[SearchResult]> results;
    // The current query (controlled from Rust).
    in-out property <string> query: "";
    callback search(string);

    background: transparent;

    VerticalLayout {
        padding: 24px;
        spacing: 16px;

        Text {
            text: "Search";
            font-size: 28px;
            font-weight: 800;
            color: Theme.system-primary;
        }

        // Search input
        Rectangle {
            height: 40px;
            border-radius: 8px;
            background: Theme.system-quinary;
            border-width: 1px;
            border-color: Theme.divider;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: center;

                AppIcon {
                    source: @image-url("icons/search.svg");
                    size: 18px;
                    tint: Theme.system-secondary;
                }

                TextInput {
                    text <=> root.query;
                    font-size: Theme.size-body;
                    color: Theme.system-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    accepted => { root.search(root.query); }
                }
            }
        }

        // Results list
        ListView {
            vertical-stretch: 1;

            for r in root.results: Rectangle {
                height: 56px;
                background: transparent;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 12px;
                    alignment: center;

                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 6px;
                        background: Theme.joe;
                    }

                    VerticalLayout {
                        spacing: 2px;
                        vertical-stretch: 0;
                        horizontal-stretch: 1;

                        Text {
                            text: r.title;
                            font-size: Theme.size-body;
                            font-weight: 600;
                            color: Theme.system-primary;
                            overflow: elide;
                            wrap: no-wrap;
                        }
                        Text {
                            text: r.artist;
                            font-size: Theme.size-callout;
                            color: Theme.system-secondary;
                            overflow: elide;
                            wrap: no-wrap;
                        }
                    }
                }
            }
        }
    }
}