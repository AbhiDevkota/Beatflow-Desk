// BeatFlow Floating Mini-Player Bar Pill

import { Tokens } from "../tokens.slint";
import {
    PlayIcon, PauseIcon, ForwardIcon, BackwardIcon, ShuffleIcon,
    RepeatIcon, RepeatOneIcon, StarIcon, StarFilledIcon, LyricsIcon,
    UpNextIcon, VolumeIcon, VolumeMuteIcon
} from "../icons.slint";
import { LcdDisplay } from "lcd.slint";

export component PlayerBar inherits Rectangle {
    in-out property <bool> is-playing: false;
    in-out property <bool> is-shuffle: false;
    in-out property <int> repeat-mode: 0; // 0 = off, 1 = all, 2 = one
    in-out property <bool> is-favorite: false;
    in-out property <bool> is-lyrics-open: false;
    in-out property <bool> is-queue-open: false;
    in-out property <float> volume-level: 0.8; // 0.0 to 1.0

    in-out property <string> track-title: "Not Playing";
    in-out property <string> artist-name: "BeatFlow";
    in-out property <string> album-title: "";
    in-out property <string> quality-badge: "Lossless";
    in-out property <float> progress-ratio: 0.0;
    in-out property <string> time-elapsed: "0:00";
    in-out property <string> time-remaining: "-0:00";
    in-out property <image> artwork-image;
    in-out property <bool> has-artwork: false;

    callback toggle-play();
    callback next-track();
    callback previous-track();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback toggle-favorite();
    callback toggle-lyrics();
    callback toggle-queue();
    callback set-volume(float);
    callback seek(float);
    callback expand-fullscreen();

    height: Tokens.player-pill-height;
    max-width: Tokens.player-max-width;
    border-radius: Tokens.radius-pill;
    background: Tokens.player-bar-bg;
    border-color: Tokens.player-bar-border;
    border-width: 1px;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000066;
    drop-shadow-offset-y: 8px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 12px;
        alignment: space-between;

        // Transport Controls (Left)
        HorizontalLayout {
            spacing: 6px;
            alignment: center;

            // Shuffle
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: shuf_touch.has-hover ? Tokens.nav-item-hover : transparent;

                ShuffleIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-color: root.is-shuffle ? Tokens.accent : (shuf_touch.has-hover ? Tokens.text-primary : Tokens.text-secondary);
                }

                shuf_touch := TouchArea {
                    clicked => { root.toggle-shuffle(); }
                }
            }

            // Previous
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: prev_touch.has-hover ? Tokens.nav-item-hover : transparent;

                BackwardIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-color: prev_touch.has-hover ? Tokens.text-primary : Tokens.text-secondary;
                }

                prev_touch := TouchArea {
                    clicked => { root.previous-track(); }
                }
            }

            // Play / Pause (Center prominent button)
            Rectangle {
                width: 36px;
                height: 36px;
                border-radius: 18px;
                background: play_touch.has-hover ? Tokens.nav-item-selected : transparent;

                if !root.is-playing: PlayIcon {
                    x: (parent.width - self.width) / 2 + 1px;
                    y: (parent.height - self.height) / 2;
                    icon-color: #ffffff;
                    width: 24px;
                    height: 24px;
                }

                if root.is-playing: PauseIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-color: #ffffff;
                    width: 24px;
                    height: 24px;
                }

                play_touch := TouchArea {
                    clicked => { root.toggle-play(); }
                }
            }

            // Next
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: next_touch.has-hover ? Tokens.nav-item-hover : transparent;

                ForwardIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-color: next_touch.has-hover ? Tokens.text-primary : Tokens.text-secondary;
                }

                next_touch := TouchArea {
                    clicked => { root.next-track(); }
                }
            }

            // Repeat (Off, All, One)
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: rep_touch.has-hover ? Tokens.nav-item-hover : transparent;

                if root.repeat-mode != 2: RepeatIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-color: root.repeat-mode == 1 ? Tokens.accent : (rep_touch.has-hover ? Tokens.text-primary : Tokens.text-secondary);
                }

                if root.repeat-mode == 2: RepeatOneIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-color: Tokens.accent;
                }

                rep_touch := TouchArea {
                    clicked => { root.cycle-repeat(); }
                }
            }
        }

        // Center LCD Display
        LcdDisplay {
            track-title: root.track-title;
            artist-name: root.artist-name;
            album-title: root.album-title;
            quality-badge: root.quality-badge;
            progress-ratio: root.progress-ratio;
            time-elapsed: root.time-elapsed;
            time-remaining: root.time-remaining;
            artwork-image: root.artwork-image;
            has-artwork: root.has-artwork;
            is-playing: root.is-playing;

            expand-fullscreen => { root.expand-fullscreen(); }
            seek(ratio) => { root.seek(ratio); }
        }

        // Right Action Buttons
        HorizontalLayout {
            spacing: 6px;
            alignment: center;

            // Favorite / Star
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: star_touch.has-hover ? Tokens.nav-item-hover : transparent;

                if !root.is-favorite: StarIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-color: star_touch.has-hover ? Tokens.accent-gold : Tokens.text-secondary;
                }

                if root.is-favorite: StarFilledIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-color: Tokens.accent-gold;
                }

                star_touch := TouchArea {
                    clicked => { root.toggle-favorite(); }
                }
            }

            // Lyrics Toggle
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: lyrics_touch.has-hover ? Tokens.nav-item-hover : transparent;

                LyricsIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-color: root.is-lyrics-open ? Tokens.accent : (lyrics_touch.has-hover ? Tokens.text-primary : Tokens.text-secondary);
                }

                lyrics_touch := TouchArea {
                    clicked => { root.toggle-lyrics(); }
                }
            }

            // Up Next / Queue Toggle
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: queue_touch.has-hover ? Tokens.nav-item-hover : transparent;

                UpNextIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    icon-color: root.is-queue-open ? Tokens.accent : (queue_touch.has-hover ? Tokens.text-primary : Tokens.text-secondary);
                }

                queue_touch := TouchArea {
                    clicked => { root.toggle-queue(); }
                }
            }

            // Volume Control with hover slider
            vol_container := Rectangle {
                width: vol_container_touch.has-hover ? 90px : 28px;
                height: 28px;
                border-radius: 14px;
                background: vol_container_touch.has-hover ? Tokens.nav-item-selected : transparent;

                animate width { duration: 150ms; easing: ease-out; }

                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: start;

                    vol_btn := Rectangle {
                        width: 18px;
                        height: 28px;

                        if root.volume-level > 0.05: VolumeIcon {
                            x: 0;
                            y: (parent.height - self.height) / 2;
                            icon-color: Tokens.text-secondary;
                        }

                        if root.volume-level <= 0.05: VolumeMuteIcon {
                            x: 0;
                            y: (parent.height - self.height) / 2;
                            icon-color: Tokens.text-tertiary;
                        }
                    }

                    // Mini volume slider track
                    if vol_container.width > 50px: Rectangle {
                        width: 50px;
                        height: 4px;
                        border-radius: 2px;
                        background: Tokens.scrubber-track;
                        y: (parent.height - self.height) / 2;

                        Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width * root.volume-level;
                            height: parent.height;
                            border-radius: 2px;
                            background: Tokens.accent;
                        }
                    }
                }

                vol_container_touch := TouchArea {
                    clicked => {
                        if self.mouse-x < 24px {
                            if root.volume-level > 0.0 {
                                root.set-volume(0.0);
                            } else {
                                root.set-volume(0.8);
                            }
                        } else {
                            root.set-volume(clamp((self.mouse-x - 28px) / 50px, 0.0, 1.0));
                        }
                    }
                    moved => {
                        if self.pressed && self.mouse-x >= 24px {
                            root.set-volume(clamp((self.mouse-x - 28px) / 50px, 0.0, 1.0));
                        }
                    }
                }
            }
        }
    }
}
