// 1:1 Album and Playlist Detail View
// Ported from web/app/src/pages/AlbumPage.tsx, PlaylistPage.tsx, and DetailHeader.tsx.

import { Theme } from "theme.slint";
import { AppIcon } from "icons.slint";
import { CollectionData, CollectionTrack, Ui } from "state.slint";
import { ShelfView } from "shelf-view.slint";

component CollectionTrackRow inherits Rectangle {
    in property <CollectionTrack> track;
    callback play();

    height: 48px;
    border-radius: 8px;
    background: row-ta.has-hover ? Theme.system-quinary : transparent;
    animate background { duration: 120ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 16px;
        spacing: 14px;
        cross-axis-alignment: center;

        // Number or Play icon on hover
        Rectangle {
            width: 24px;
            height: 24px;
            background: transparent;

            if !row-ta.has-hover: Text {
                width: 100%;
                height: 100%;
                text: root.track.index;
                font-size: 13px;
                color: Theme.system-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if row-ta.has-hover: AppIcon {
                x: 4px;
                y: 4px;
                size: 16px;
                source: @image-url("icons/play.svg");
                tint: Theme.key-color;
            }
        }

        // Small thumbnail (for playlists)
        if root.track.has-thumbnail: Rectangle {
            width: 36px;
            height: 36px;
            border-radius: 4px;
            clip: true;
            background: Theme.joe;

            Image {
                width: 100%;
                height: 100%;
                source: root.track.thumbnail;
                image-fit: cover;
            }
        }

        // Title + Artist
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.track.title;
                font-size: Theme.size-body;
                font-weight: 500;
                color: Theme.system-primary;
                overflow: elide;
            }

            if root.track.artist != "": Text {
                text: root.track.artist;
                font-size: Theme.size-callout;
                color: Theme.system-secondary;
                overflow: elide;
            }
        }

        // Duration
        Text {
            text: root.track.duration;
            font-size: 13px;
            color: Theme.system-secondary;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    row-ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.play(); }
    }
}

export component CollectionPage inherits Rectangle {
    background: transparent;

    Flickable {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        content-width: parent.width;
        content-height: 80px + 280px + Math.max(100px, CollectionData.tracks.length * 50px) + (CollectionData.more.length * 280px) + 120px;

        VerticalLayout {
            padding-left: Theme.body-gutter;
            padding-right: Theme.body-gutter;
            padding-top: 16px;
            padding-bottom: 120px;
            spacing: 28px;

            // Back button
            HorizontalLayout {
                height: 36px;

                Rectangle {
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: back-ta.has-hover ? Theme.system-quaternary : Theme.system-quinary;
                    animate background { duration: 150ms; }

                    AppIcon {
                        x: 8px;
                        y: 8px;
                        size: 20px;
                        source: @image-url("icons/chevron-left.svg");
                        tint: Theme.system-primary;
                    }

                    back-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { CollectionData.back(); }
                    }
                }
            }

            // Detail Header (Apple Music 1:1)
            HorizontalLayout {
                spacing: 32px;
                alignment: start;

                // Artwork with Radiosity Glow effect
                Rectangle {
                    width: 240px;
                    height: 240px;
                    background: transparent;

                    // Glow layer
                    if CollectionData.has-thumbnail: Rectangle {
                        x: -8px;
                        y: 6px;
                        width: parent.width + 16px;
                        height: parent.height + 16px;
                        border-radius: Theme.radius-artwork-large + 4px;
                        opacity: 0.35;
                        clip: true;
                        Image {
                            width: 100%;
                            height: 100%;
                            source: CollectionData.thumbnail;
                            image-fit: cover;
                        }
                    }

                    // Foreground Album Artwork
                    Rectangle {
                        width: 100%;
                        height: 100%;
                        border-radius: Theme.radius-artwork-large;
                        clip: true;
                        background: Theme.joe;

                        if CollectionData.has-thumbnail: Image {
                            width: 100%;
                            height: 100%;
                            source: CollectionData.thumbnail;
                            image-fit: cover;
                        }

                        if !CollectionData.has-thumbnail: AppIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            size: 64px;
                            source: @image-url("icons/albums.svg");
                            tint: Theme.system-secondary;
                        }
                    }
                }

                // Headings & Actions
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: start;
                    spacing: 8px;

                    // Title
                    Text {
                        text: CollectionData.title;
                        font-size: 32px;
                        font-weight: 700;
                        color: Theme.system-primary;
                        wrap: word-wrap;
                    }

                    // Subtitle / Artists
                    if CollectionData.subtitle != "": Text {
                        text: CollectionData.subtitle;
                        font-size: 18px;
                        font-weight: 500;
                        color: Theme.key-color;
                    }

                    // Byline / Meta ("2024 • 12 songs, 42 minutes")
                    if CollectionData.byline != "": Text {
                        text: CollectionData.byline;
                        font-size: 13px;
                        color: Theme.system-secondary;
                    }

                    // Description (if present)
                    if CollectionData.description != "": Text {
                        text: CollectionData.description;
                        font-size: 13px;
                        color: Theme.system-secondary;
                        wrap: word-wrap;
                        overflow: elide;
                    }

                    // Actions: Play and Shuffle buttons
                    Rectangle { height: 12px; }

                    HorizontalLayout {
                        spacing: 12px;

                        // Play Pill Button
                        Rectangle {
                            height: 38px;
                            width: 140px;
                            border-radius: 19px;
                            background: play-all-ta.has-hover ? Theme.key-color : Theme.key-color-bg;
                            animate background { duration: 150ms; }

                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;

                                AppIcon {
                                    size: 18px;
                                    source: @image-url("icons/play.svg");
                                    tint: #ffffff;
                                }

                                Text {
                                    text: "Play";
                                    font-size: 15px;
                                    font-weight: 600;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                }
                            }

                            play-all-ta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { CollectionData.play-all(); }
                            }
                        }

                        // Shuffle Button
                        Rectangle {
                            width: 38px;
                            height: 38px;
                            border-radius: 19px;
                            border-width: 1px;
                            border-color: Theme.divider;
                            background: shuffle-ta.has-hover ? Theme.system-quaternary : Theme.thin-material;
                            animate background { duration: 150ms; }

                            AppIcon {
                                x: 10px;
                                y: 10px;
                                size: 18px;
                                source: @image-url("icons/shuffle.svg");
                                tint: Theme.system-primary;
                            }

                            shuffle-ta := TouchArea {
                                mouse-cursor: MouseCursor.pointer;
                                clicked => { CollectionData.shuffle-all(); }
                            }
                        }
                    }
                }
            }

            // Divider line
            Rectangle {
                height: 1px;
                background: Theme.system-quinary;
            }

            // Tracklist
            VerticalLayout {
                spacing: 2px;

                for track in CollectionData.tracks: CollectionTrackRow {
                    track: track;
                    play => { CollectionData.play-track(track.index); }
                }
            }

            // More by Artist Shelves (if any)
            if CollectionData.more.length > 0: VerticalLayout {
                spacing: 24px;
                for shelf in CollectionData.more: ShelfView {
                    shelf: shelf;
                }
            }
        }
    }
}
