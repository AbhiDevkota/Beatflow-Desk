// BeatFlow Settings View

import { Tokens } from "../tokens.slint";
import { CheckIcon, ChevronRightIcon } from "../icons.slint";

export component SettingsToggle inherits Rectangle {
    in-out property <string> title: "";
    in-out property <string> subtitle: "";
    in-out property <bool> is-checked: false;

    callback toggled(bool);

    height: 52px;
    border-radius: Tokens.radius-medium;
    background: toggle_touch.has-hover ? Tokens.nav-item-hover : transparent;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: space-between;

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.title;
                color: Tokens.text-primary;
                font-size: Tokens.font-size-body;
                font-weight: Tokens.font-weight-medium;
            }

            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Tokens.text-tertiary;
                font-size: Tokens.font-size-caption;
            }
        }

        // Switch pill
        sw := Rectangle {
            width: 44px;
            height: 24px;
            border-radius: 12px;
            background: root.is-checked ? Tokens.accent : Tokens.nav-item-selected;
            y: (parent.height - self.height) / 2;

            // Thumb
            Rectangle {
                x: root.is-checked ? parent.width - self.width - 2px : 2px;
                y: 2px;
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: #ffffff;
                animate x { duration: 150ms; easing: ease-out; }
            }
        }
    }

    toggle_touch := TouchArea {
        clicked => {
            root.is-checked = !root.is-checked;
            root.toggled(root.is-checked);
        }
    }
}

export component SettingsView inherits Rectangle {
    in-out property <string> audio-quality-tier: "Hi-Res Lossless (24-bit/192kHz)";
    in-out property <string> preferred-addon: "Apple Music";
    in-out property <bool> enable-atmos: true;
    in-out property <bool> enable-discord-rpc: true;
    in-out property <bool> enable-gapless: true;
    in-out property <bool> enable-normalization: false;
    in-out property <string> download-path: "C:\\Users\\...\\Music\\BeatFlow";
    in-out property <bool> is-yt-authed: false;
    in-out property <bool> is-spotify-authed: false;
    in-out property <string> app-version: "1.9.2 (Native Rust + Slint)";

    callback select-audio-tier(string);
    callback select-addon(string);
    callback toggle-atmos(bool);
    callback toggle-discord-rpc(bool);
    callback toggle-gapless(bool);
    callback toggle-normalization(bool);
    callback change-download-path();
    callback open-yt-cookie-dialog();
    callback open-spotify-auth();

    background: transparent;

    Flickable {
        content-height: 980px;

        VerticalLayout {
            padding-left: Tokens.content-gutter;
            padding-right: Tokens.content-gutter;
            padding-top: 20px;
            padding-bottom: 120px;
            spacing: 28px;
            max-width: 680px;

            // Header
            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "PREFERENCES";
                    color: Tokens.text-tertiary;
                    font-size: Tokens.font-size-caption;
                    font-weight: Tokens.font-weight-bold;
                    letter-spacing: 0.8px;
                }
                Text {
                    text: "Settings";
                    color: Tokens.text-primary;
                    font-size: 28px;
                    font-weight: Tokens.font-weight-bold;
                }
            }

            // Section 1: Audio Quality & Hi-Res Engine
            VerticalLayout {
                spacing: 8px;

                Text {
                    text: "Audio Quality & Streaming Tier";
                    color: Tokens.text-secondary;
                    font-size: Tokens.font-size-title;
                    font-weight: Tokens.font-weight-semibold;
                }

                Rectangle {
                    border-radius: Tokens.radius-large;
                    background: Tokens.card-bg;
                    border-color: Tokens.border-subtle;
                    border-width: 1px;

                    VerticalLayout {
                        padding: 6px;

                        // Quality selector row
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            height: 48px;
                            alignment: space-between;

                            Text {
                                text: "Streaming Quality";
                                color: Tokens.text-primary;
                                font-size: Tokens.font-size-body;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.audio-quality-tier;
                                color: Tokens.accent;
                                font-size: Tokens.font-size-body;
                                font-weight: Tokens.font-weight-semibold;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle { height: 1px; background: Tokens.border-divider; }

                        // Preferred Addon row
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            height: 48px;
                            alignment: space-between;

                            Text {
                                text: "Preferred Hi-Res Addon";
                                color: Tokens.text-primary;
                                font-size: Tokens.font-size-body;
                                vertical-alignment: center;
                            }

                            Text {
                                text: root.preferred-addon;
                                color: Tokens.text-secondary;
                                font-size: Tokens.font-size-body;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle { height: 1px; background: Tokens.border-divider; }

                        SettingsToggle {
                            title: "Prefer Dolby Atmos / Spatial Streams";
                            subtitle: "Selects multi-channel audio stream when available in addon catalog";
                            is-checked: root.enable-atmos;
                            toggled(val) => { root.toggle-atmos(val); }
                        }
                    }
                }
            }

            // Section 2: Playback Features
            VerticalLayout {
                spacing: 8px;

                Text {
                    text: "Playback Controls";
                    color: Tokens.text-secondary;
                    font-size: Tokens.font-size-title;
                    font-weight: Tokens.font-weight-semibold;
                }

                Rectangle {
                    border-radius: Tokens.radius-large;
                    background: Tokens.card-bg;
                    border-color: Tokens.border-subtle;
                    border-width: 1px;

                    VerticalLayout {
                        padding: 6px;

                        SettingsToggle {
                            title: "Gapless Audio Playback";
                            subtitle: "Pre-buffers subsequent tracks for zero silence between songs";
                            is-checked: root.enable-gapless;
                            toggled(val) => { root.toggle-gapless(val); }
                        }

                        Rectangle { height: 1px; background: Tokens.border-divider; }

                        SettingsToggle {
                            title: "Sound Check (Loudness Normalization)";
                            subtitle: "Enables consistent listening volume across diverse masterings";
                            is-checked: root.enable-normalization;
                            toggled(val) => { root.toggle-normalization(val); }
                        }
                    }
                }
            }

            // Section 3: Integrations & Services
            VerticalLayout {
                spacing: 8px;

                Text {
                    text: "Accounts & Integrations";
                    color: Tokens.text-secondary;
                    font-size: Tokens.font-size-title;
                    font-weight: Tokens.font-weight-semibold;
                }

                Rectangle {
                    border-radius: Tokens.radius-large;
                    background: Tokens.card-bg;
                    border-color: Tokens.border-subtle;
                    border-width: 1px;

                    VerticalLayout {
                        padding: 6px;

                        // YouTube Music
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            height: 52px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: "YouTube Music Account";
                                    color: Tokens.text-primary;
                                    font-size: Tokens.font-size-body;
                                    font-weight: Tokens.font-weight-medium;
                                }
                                Text {
                                    text: root.is-yt-authed ? "Connected via secure session cookies" : "Not connected (Public catalog only)";
                                    color: root.is-yt-authed ? Tokens.accent-green : Tokens.text-tertiary;
                                    font-size: Tokens.font-size-caption;
                                }
                            }

                            Rectangle {
                                width: 80px;
                                height: 30px;
                                border-radius: 15px;
                                background: yt_touch.has-hover ? Tokens.nav-item-selected : Tokens.nav-item-hover;
                                y: (parent.height - self.height) / 2;

                                Text {
                                    text: root.is-yt-authed ? "Manage" : "Sign In";
                                    color: Tokens.text-primary;
                                    font-size: Tokens.font-size-caption;
                                    font-weight: Tokens.font-weight-semibold;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                yt_touch := TouchArea {
                                    clicked => { root.open-yt-cookie-dialog(); }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Tokens.border-divider; }

                        // Spotify
                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            height: 52px;
                            alignment: space-between;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: "Spotify Playlist Sync";
                                    color: Tokens.text-primary;
                                    font-size: Tokens.font-size-body;
                                    font-weight: Tokens.font-weight-medium;
                                }
                                Text {
                                    text: root.is-spotify-authed ? "Connected (Syncing library)" : "Disconnected";
                                    color: root.is-spotify-authed ? Tokens.accent-green : Tokens.text-tertiary;
                                    font-size: Tokens.font-size-caption;
                                }
                            }

                            Rectangle {
                                width: 80px;
                                height: 30px;
                                border-radius: 15px;
                                background: sp_touch.has-hover ? Tokens.nav-item-selected : Tokens.nav-item-hover;
                                y: (parent.height - self.height) / 2;

                                Text {
                                    text: root.is-spotify-authed ? "Sync" : "Connect";
                                    color: Tokens.text-primary;
                                    font-size: Tokens.font-size-caption;
                                    font-weight: Tokens.font-weight-semibold;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }

                                sp_touch := TouchArea {
                                    clicked => { root.open-spotify-auth(); }
                                }
                            }
                        }
                    }
                }
            }

            // Section 4: Desktop Features & Discord RPC
            VerticalLayout {
                spacing: 8px;

                Text {
                    text: "System & Desktop";
                    color: Tokens.text-secondary;
                    font-size: Tokens.font-size-title;
                    font-weight: Tokens.font-weight-semibold;
                }

                Rectangle {
                    border-radius: Tokens.radius-large;
                    background: Tokens.card-bg;
                    border-color: Tokens.border-subtle;
                    border-width: 1px;

                    VerticalLayout {
                        padding: 6px;

                        SettingsToggle {
                            title: "Discord Rich Presence";
                            subtitle: "Broadcasts currently playing song and artist to Discord activity";
                            is-checked: root.enable-discord-rpc;
                            toggled(val) => { root.toggle-discord-rpc(val); }
                        }
                    }
                }
            }

            // About Footer
            VerticalLayout {
                spacing: 6px;
                alignment: center;
                padding-top: 20px;

                Text {
                    text: "BeatFlow Desktop";
                    color: Tokens.text-secondary;
                    font-size: Tokens.font-size-body;
                    font-weight: Tokens.font-weight-semibold;
                    horizontal-alignment: center;
                }

                Text {
                    text: "Version " + root.app-version;
                    color: Tokens.text-tertiary;
                    font-size: Tokens.font-size-caption;
                    horizontal-alignment: center;
                }
            }
        }
    }
}
