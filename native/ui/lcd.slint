// The now-playing tile inside the player pill, ported from
// web/app/src/shell/Lcd.tsx: 34px artwork (60px for videos, later), the title
// and artist line, and the 2px seek line along the bottom that grows to 4px on
// hover with the elapsed/remaining times fading in over it.

import { Theme } from "theme.slint";
import { Player } from "state.slint";
import { AppIcon } from "icons.slint";

export component Lcd inherits Rectangle {
    // PlayerBar.tsx's `group-hover/pill`: hovering anywhere on the pill dims
    // the artwork and shows the expand glyph. Union of the pill's own
    // TouchArea plus every interactive child (hover is not inherited in Slint).
    in property <bool> pill-hover: false;

    // This component's own hit areas, so the pill can union them into
    // `pill-hover` (the info column has no TouchArea of its own).
    in-out property <bool> hover: art-ta.has-hover || scrubber.has-hover;

    // useScrubber: the names soften while the pointer is on the seek line
    // (opacity-30 + blur(3px); Slint has no per-element blur filter, so this
    // reproduces the opacity half).
    property <bool> scrub-active: scrubber.has-hover || scrubber.drag >= 0;
    // During a drag the scrubber shows the pointer's fraction (useScrubber
    // draws `dragging * duration` before seeking on release).
    property <float> shown-progress: scrubber.drag >= 0 ? scrubber.drag : Player.progress;
    // The times the draw loop writes: the drag position while scrubbing.
    property <float> shown-elapsed: root.shown-progress * Player.duration;

    // useScrubber.ts's clock(): "m:ss", floored; negatives clamp to "0:00"
    // (the remaining label adds its own "-").
    function clock-text(seconds: float) -> string {
        if (seconds < 0.0) {
            return "0:00";
        }
        return "\{Math.floor(seconds / 60.0)}:\{two-digits(Math.mod(Math.floor(seconds), 60.0))}";
    }

    function two-digits(v: float) -> string {
        if (v < 10.0) {
            return "0\{v}";
        }
        return "\{v}";
    }

    height: 100%;

    HorizontalLayout {
        y: 0;
        height: parent.height - 6px; // pb-1.5
        spacing: 8px;                // gap-x-2
        padding-left: 16px;
        padding-right: 16px;
        cross-axis-alignment: center;

        // ---- #miniplayer-artwork: opens the full-screen player (later) ----
        Rectangle {
            width: 34px;
            height: 34px;
            border-radius: 6px; // rounded-[6px]
            clip: true;
            background: Theme.joe; // placeholder until artwork loads

            if Player.has-artwork: Image {
                width: 100%;
                height: 100%;
                source: Player.artwork;
                image-fit: cover;
            }

            if !Player.has-artwork: AppIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                size: 18px;
                source: @image-url("icons/songs.svg");
                tint: Theme.system-secondary;
                opacity: 0.5;
            }

            // group-hover/pill: black 50% + Maximize2 14px, 200ms fade
            overlay := Rectangle {
                background: #00000080;
                opacity: root.pill-hover ? 1 : 0;
                animate opacity { duration: 200ms; }

                AppIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    source: @image-url("icons/maximize-2.svg");
                    size: 14px;
                    tint: #ffffff;
                }
            }

            art-ta := TouchArea {
                // full-screen expansion arrives with Stage 5; no-op for now
                clicked => { }
            }
        }

        // ---- #miniplayer-info: title + artist ------------------------------
        Rectangle {
            horizontal-stretch: 1;
            opacity: root.scrub-active ? 0.3 : 1.0;
            animate opacity { duration: 100ms; }

            VerticalLayout {
                spacing: 0;
                alignment: center;

                // title: type-body-emphasized (600 13px/16px), truncates
                Text {
                    vertical-alignment: center;
                    text: Player.title;
                    font-size: Theme.size-body;
                    font-weight: 600;
                    color: Theme.system-primary;
                    overflow: elide;
                    wrap: no-wrap;
                    max-height: 16px;
                }

                // artist: type-callout-medium (500 12px/15px), secondary
                Text {
                    vertical-alignment: center;
                    text: Player.artist;
                    font-size: Theme.size-callout;
                    font-weight: 500;
                    color: Theme.system-secondary;
                    overflow: elide;
                    wrap: no-wrap;
                    max-height: 15px;
                }
            }
        }
    }

    // ---- #miniplayer-scrubber: the seek line -------------------------------
    // Hit area h-3.5 (14px) across the LCD's bottom; the 2px line sits 6px up
    // (5px when hovered) and grows to 4px; times fade in above it.
    scrubber := TouchArea {
        x: 0;
        y: parent.height - 14px;
        width: parent.width;
        height: 14px;
        mouse-cursor: MouseCursor.pointer;

        in-out property <float> drag: -1; // pointer fraction while pressed

        // useScrubber: press captures, moves update the display, and the seek
        // lands on release; a cancelled pointer just drops the drag.
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.drag = Math.clamp(self.mouse-x / self.width, 0, 1);
            }
            if (e.kind == PointerEventKind.up) {
                Player.seeked(self.drag);
                self.drag = -1;
            }
            if (e.kind == PointerEventKind.cancel) {
                self.drag = -1;
            }
        }
        moved => {
            if (self.drag >= 0) {
                self.drag = Math.clamp(self.mouse-x / self.width, 0, 1);
            }
        }
    }

    // The track line (bg-quaternary) with the played fill (bg-secondary).
    Rectangle {
        x: 0;
        width: parent.width;
        y: parent.height - (root.scrub-active ? 4px : 2px) - (root.scrub-active ? 5px : 6px);
        height: root.scrub-active ? 4px : 2px;
        border-radius: 1px;
        background: Theme.system-quaternary;
        clip: true;
        animate height, y { duration: 100ms; easing: ease-in; }

        Rectangle {
            x: 0;
            height: 100%;
            width: parent.width * root.shown-progress;
            background: Theme.system-secondary;
        }
    }

    // Elapsed / remaining (600 11px/13px, bottom-11px), opacity follows the
    // hover/drag state; the strings come from clock-text above.
    Text {
        x: 0;
        y: parent.height - 24px;
        text: root.clock-text(root.shown-elapsed);
        font-size: Theme.size-subhead;
        font-weight: 600;
        color: Theme.system-primary;
        opacity: root.scrub-active ? 1 : 0;
        animate opacity { duration: 150ms; }
    }

    Text {
        x: parent.width - self.width;
        y: parent.height - 24px;
        text: "-\{root.clock-text(Player.duration - root.shown-elapsed)}";
        font-size: Theme.size-subhead;
        font-weight: 600;
        color: Theme.system-primary;
        opacity: root.scrub-active ? 1 : 0;
        animate opacity { duration: 150ms; }
    }
}
