// The Home page, ported 1:1 from web/app/src/pages/HomePage.tsx and the
// components it composes:
//
//   1. PageHeader "Home"
//   2. Top Picks for You (home/TopPicksShelf.tsx): 240px 3:4 portrait cards
//      with the bottom gradient caption and the logo badge
//   3. Recently Played (music/ShelfView.tsx's TrackShelf): the 4-row track
//      columns
//   4. The lead feed shelf, Find Your Mood (home/FindYourMoodShelf.tsx),
//      then the remaining shelves — Android's exact slice order
//
// Every shelf section keeps the web's pt-9 (36px); the page clears the
// floating player pill with pb-[calc(56+20+40)px] = 116px (Theme.page-bottom-padding).

import { Theme } from "theme.slint";
import { AppIcon } from "icons.slint";
import { ShelfItem, MoodItem, HomeData, Player } from "state.slint";
import { PageHeader } from "page-header.slint";
import { ShelfTitle, ShelfArrow, ShelfView } from "shelf-view.slint";
import { PlayingBars } from "playing-bars.slint";

// ---------------------------------------------------------------------------
// Top Picks for You (home/TopPicksShelf.tsx)
// ---------------------------------------------------------------------------

component TopPicksCard inherits Rectangle {
    in property <ShelfItem> pick;
    callback play();

    width: 240px;
    height: 320px;                       // aspect-[3/4]
    border-radius: Theme.radius-card;    // rounded-xl
    clip: true;
    background: Theme.joe;

    // Background art
    if root.pick.has-thumbnail: Image {
        width: 100%;
        height: 100%;
        source: root.pick.thumbnail;
        image-fit: cover;
    }
    if !root.pick.has-thumbnail: AppIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: 40px;
        source: @image-url("icons/songs.svg");
        tint: Theme.system-secondary;
    }

    // Dark gradient for caption contrast
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(0deg, #000000d9, #00000059 50%, transparent);
    }

    // BeatFlow logo badge (top-3 right-3, size-6, bg-black/30)
    Rectangle {
        x: parent.width - 36px;
        y: 12px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        background: #0000004d;

        AppIcon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            size: 14px;
            source: @image-url("icons/logo-mark.svg");
            tint: #ffffffe6;
        }
    }

    // Caption (bottom, p-4)
    VerticalLayout {
        x: 0;
        y: parent.height - self.preferred-height;
        width: parent.width;
        padding: 16px;
        spacing: 2px;

        Text {
            text: root.pick.title;
            font-size: 18px;
            font-weight: 700;
            color: #ffffff;
            height: 45px;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: top;
        }

        if root.pick.subtitle != "": Text {
            text: root.pick.subtitle;
            font-size: 12px;
            color: #ffffffcc;
            overflow: elide;
            wrap: no-wrap;
        }
    }

    card-ta := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.play(); }
    }
}

component TopPicksShelf inherits Rectangle {
    height: 22px + 14px + 320px;
    background: transparent;

    ShelfTitle {
        x: Theme.body-gutter;
        width: parent.width - 2 * Theme.body-gutter;
        title: "Top Picks for You";
    }

    Rectangle {
        y: 36px;
        width: 100%;
        height: 320px;

        shelf-ta := TouchArea {
            width: 100%;
            height: 100%;
        }

        scroller := Flickable {
            width: 100%;
            height: 100%;
            content-height: self.height;
            content-width: HomeData.top-picks.length * (240px + 16px) + 2 * Theme.body-gutter;

            HorizontalLayout {
                spacing: 16px;
                padding-left: Theme.body-gutter;
                padding-right: Theme.body-gutter;

                for pick in HomeData.top-picks: TopPicksCard {
                    pick: pick;
                    play => { HomeData.play(pick); }
                }
            }
        }

        if scroller.content-width > scroller.width: ShelfArrow {
            y: (parent.height - self.height) / 2;
            x: 6px;
            forward: false;
            shelf-hover: shelf-ta.has-hover;
            clicked => { scroller.content-x += scroller.width - 2 * Theme.body-gutter; }
        }
        if scroller.content-width > scroller.width: ShelfArrow {
            y: (parent.height - self.height) / 2;
            x: parent.width - self.width - 6px;
            forward: true;
            shelf-hover: shelf-ta.has-hover;
            clicked => { scroller.content-x -= scroller.width - 2 * Theme.body-gutter; }
        }
    }
}

// ---------------------------------------------------------------------------
// Find Your Mood (home/FindYourMoodShelf.tsx)
// ---------------------------------------------------------------------------

// 1:1 Animated Mood Emblems ported directly from Android Skia / MoodCanvas.tsx
component MoodEmblem inherits Rectangle {
    in property <MoodItem> mood;

    property <color> stroke: root.mood.stroke;
    property <float> phase: Player.beat-phase;

    // ENERGY: electric lightning bolt with animated ghost flashes
    if root.mood.key == "Energy": Rectangle {
        width: 100%;
        height: 100%;

        property <float> p: Math.mod(root.phase * 2.0, 1.0);
        property <float> flash: (p >= 0.25 && p <= 0.55) ? Math.sin((p - 0.25) / 0.30 * 180deg) : 0.0;

        // Ghost flash echo 1 (shifted right)
        if flash > 0.05: Path {
            x: 6px * flash;
            width: 100%;
            height: 100%;
            viewbox-width: 100;
            viewbox-height: 100;
            commands: "M 48.6 12.3 L 88.6 12.3 L 53.2 50.9 L 87.7 50.9 L 11.4 89.5 L 40.9 61.4 L 10.5 61.4 Z";
            stroke: root.stroke;
            stroke-width: 2.4px;
            opacity: 0.55 * flash;
        }

        // Ghost flash echo 2 (shifted left)
        if flash > 0.05: Path {
            x: -5px * flash;
            width: 100%;
            height: 100%;
            viewbox-width: 100;
            viewbox-height: 100;
            commands: "M 48.6 12.3 L 88.6 12.3 L 53.2 50.9 L 87.7 50.9 L 11.4 89.5 L 40.9 61.4 L 10.5 61.4 Z";
            stroke: root.stroke;
            stroke-width: 2.4px;
            opacity: 0.35 * flash;
        }

        // Main sharp lightning bolt
        Path {
            width: 100%;
            height: 100%;
            viewbox-width: 100;
            viewbox-height: 100;
            commands: "M 48.6 12.3 L 88.6 12.3 L 53.2 50.9 L 87.7 50.9 L 11.4 89.5 L 40.9 61.4 L 10.5 61.4 Z";
            stroke: root.stroke;
            stroke-width: 2.4px;
        }
    }

    // RELAX: three calming balanced stones smoothly swaying with sinusoidal waves
    if root.mood.key == "Relax": Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        property <float> s1: Math.sin(root.phase * 360deg);
        property <float> s2: Math.sin((root.phase + 0.22) * 360deg);
        property <float> s3: Math.sin((root.phase + 0.44) * 360deg);

        // Top stone
        Rectangle {
            x: (parent.width - parent.width * 0.44) / 2 + 4px * s1;
            y: parent.height * 0.17 - parent.height * 0.09;
            width: parent.width * 0.44;
            height: parent.height * 0.18;
            border-radius: self.height / 2;
            border-width: 2.2px;
            border-color: root.stroke;
        }

        // Middle stone
        Rectangle {
            x: (parent.width - parent.width * 0.68) / 2 + 5px * s2;
            y: parent.height * 0.38 - parent.height * 0.14;
            width: parent.width * 0.68;
            height: parent.height * 0.28;
            border-radius: self.height / 2;
            border-width: 2.2px;
            border-color: root.stroke;
        }

        // Bottom stone
        Rectangle {
            x: (parent.width - parent.width * 0.84) / 2 + 3px * s3;
            y: parent.height * 0.66 - parent.height * 0.18;
            width: parent.width * 0.84;
            height: parent.height * 0.36;
            border-radius: self.height / 2;
            border-width: 2.2px;
            border-color: root.stroke;
        }
    }

    // FEELING BLUE: undulating contemplative spiral
    if root.mood.key == "Feeling Blue": Rectangle {
        width: 100%;
        height: 100%;

        property <float> pulse: 0.92 + 0.08 * (0.5 + 0.5 * Math.sin(root.phase * 360deg));
        property <float> sway: Math.sin(root.phase * 360deg);

        Path {
            x: (parent.width - self.width) / 2 + 2px * sway;
            y: (parent.height - self.height) / 2;
            width: parent.width * pulse;
            height: parent.height * pulse;
            viewbox-width: 100;
            viewbox-height: 100;
            commands: "M 50 10 C 84 10 92 36 92 52 C 92 78 74 92 52 92 C 32 92 14 78 14 58 C 14 42 26 32 40 32 C 52 32 60 42 60 52 C 60 60 54 66 47 66 C 42 66 38 62 38 57";
            stroke: root.stroke;
            stroke-width: 2.4px;
        }
    }

    // FEEL GOOD: breathing, swaying 4-point star
    if root.mood.key == "Feel Good": Rectangle {
        width: 100%;
        height: 100%;

        property <float> pulse: 0.88 + 0.14 * (0.5 + 0.5 * Math.sin(root.phase * 360deg));
        property <float> sway: Math.sin(root.phase * 360deg);

        Path {
            x: (parent.width - self.width) / 2 + 4px * sway;
            y: (parent.height - self.height) / 2;
            width: parent.width * pulse;
            height: parent.height * pulse;
            viewbox-width: 100;
            viewbox-height: 100;
            commands: "M 50 6 L 61 39 L 94 50 L 61 61 L 50 94 L 39 61 L 6 50 L 39 39 Z";
            stroke: root.stroke;
            stroke-width: 2.4px;
        }
    }

    // FOCUS: hypnotic concentric rings continuously expanding and fading
    if root.mood.key == "Focus": Rectangle {
        width: 100%;
        height: 100%;
        background: transparent;

        property <float> d1: Math.mod(root.phase, 1.0);
        property <float> d2: Math.mod(root.phase + 0.333, 1.0);
        property <float> d3: Math.mod(root.phase + 0.666, 1.0);

        // Ripple Ring 1
        Rectangle {
            property <length> sz: parent.width * (0.22 + 0.78 * d1);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: sz;
            height: sz;
            border-radius: sz / 2;
            border-width: 2.2px;
            border-color: root.stroke;
            opacity: Math.max(0.0, 1.0 - d1);
        }

        // Ripple Ring 2
        Rectangle {
            property <length> sz: parent.width * (0.22 + 0.78 * d2);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: sz;
            height: sz;
            border-radius: sz / 2;
            border-width: 2.2px;
            border-color: root.stroke;
            opacity: Math.max(0.0, 1.0 - d2);
        }

        // Ripple Ring 3
        Rectangle {
            property <length> sz: parent.width * (0.22 + 0.78 * d3);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: sz;
            height: sz;
            border-radius: sz / 2;
            border-width: 2.2px;
            border-color: root.stroke;
            opacity: Math.max(0.0, 1.0 - d3);
        }
    }

    // HEARTBREAK: fractured heart pulsing with melancholy breathing
    if root.mood.key == "Heartbreak": Rectangle {
        width: 100%;
        height: 100%;

        property <float> pulse: 0.93 + 0.07 * (0.5 + 0.5 * Math.sin(root.phase * 360deg));

        Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: parent.width * pulse;
            height: parent.height * pulse;
            viewbox-width: 100;
            viewbox-height: 100;
            commands: "M 50 22 C 49 14 43 8 34 8 C 22 8 10 18 10 36 C 10 56 30 76 50 92 C 70 76 90 56 90 36 C 90 18 78 8 66 8 C 57 8 51 14 50 22 L 48 38 L 54 48 L 47 62 L 53 74 L 50 92";
            stroke: root.stroke;
            stroke-width: 2.4px;
        }
    }

    // LOVE: realistic double-bump beating heart (lub-dub rhythm)
    if root.mood.key == "Love": Rectangle {
        width: 100%;
        height: 100%;

        property <float> p: Math.mod(root.phase * 1.6, 1.0);
        property <float> b1: (p >= 0.10 && p <= 0.28) ? Math.sin((p - 0.10) / 0.18 * 180deg) : 0.0;
        property <float> b2: (p >= 0.30 && p <= 0.46) ? Math.sin((p - 0.30) / 0.16 * 180deg) * 0.75 : 0.0;
        property <float> beat: 1.0 + 0.14 * (b1 + b2);

        Path {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: parent.width * beat;
            height: parent.height * beat;
            viewbox-width: 100;
            viewbox-height: 100;
            commands: "M 50 92 C 30 76 10 56 10 36 C 10 18 22 8 34 8 C 43 8 49 14 50 22 C 51 14 57 8 66 8 C 78 8 90 18 90 36 C 90 56 70 76 50 92 Z";
            stroke: root.stroke;
            stroke-width: 2.4px;
        }
    }
}

// One mood tile with smooth hover scale animation and BeatFlow status badge
component MoodTile inherits Rectangle {
    in property <MoodItem> mood;
    callback play();

    width: 170px;
    height: 170px + 8px + 20px;
    background: transparent;

    property <bool> hover: mood-ta.has-hover;

    // Tile container with smooth hover zoom
    Rectangle {
        width: root.hover ? 170px : 166px;
        height: root.hover ? 170px : 166px;
        x: (parent.width - self.width) / 2;
        y: root.hover ? 0px : 2px;
        border-radius: Theme.radius-card;
        clip: true;
        background: root.mood.background;
        animate width, height, y { duration: 200ms; easing: ease-out; }
        drop-shadow-blur: root.hover ? 10px : 2px;
        drop-shadow-color: root.hover ? #00000045 : #00000015;

        // Animated emblem
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: parent.width * 0.70;
            height: parent.height * 0.70;

            MoodEmblem {
                width: 100%;
                height: 100%;
                mood: root.mood;
            }
        }

        // Top-right BeatFlow badge: shows PlayingBars when active, or logo mark
        Rectangle {
            x: parent.width - 32px;
            y: 10px;
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: #00000040;

            if Player.status == 1 && Player.artist == root.mood.title: PlayingBars {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                size: 16px;
            }

            if Player.status != 1 || Player.artist != root.mood.title: AppIcon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                size: 12px;
                source: @image-url("icons/logo-mark.svg");
                tint: #fffffff2;
            }
        }

        mood-ta := TouchArea {
            mouse-cursor: MouseCursor.pointer;
            clicked => { root.play(); }
        }
    }

    // Title below tile
    Text {
        y: 170px + 8px;
        width: parent.width;
        text: root.mood.title;
        font-size: 14px;
        font-weight: 600;
        color: root.hover ? Theme.key-color : Theme.system-primary;
        overflow: elide;
        wrap: no-wrap;
        animate color { duration: 150ms; }
    }
}

// Find Your Mood shelf: matching web app's horizontal scroller with glass pill arrows and NO "Show more" button
component MoodShelf inherits Rectangle {
    height: 22px + 14px + 208px;
    background: transparent;

    ShelfTitle {
        x: Theme.body-gutter;
        width: parent.width - 2 * Theme.body-gutter;
        title: "Find Your Mood";
    }

    Rectangle {
        y: 36px;
        width: 100%;
        height: 208px;

        shelf-ta := TouchArea {
            width: 100%;
            height: 100%;
        }

        scroller := Flickable {
            width: 100%;
            height: 100%;
            content-height: self.height;
            content-width: HomeData.moods.length * 184px + 2 * Theme.body-gutter;

            HorizontalLayout {
                spacing: 14px;
                padding-left: Theme.body-gutter;
                padding-right: Theme.body-gutter;

                for mood in HomeData.moods: MoodTile {
                    mood: mood;
                    play => { HomeData.play-mood(mood.key); }
                }
            }
        }

        if scroller.content-width > scroller.width: ShelfArrow {
            y: (parent.height - self.height) / 2;
            x: 6px;
            forward: false;
            shelf-hover: shelf-ta.has-hover;
            clicked => { scroller.content-x += scroller.width - 2 * Theme.body-gutter; }
        }
        if scroller.content-width > scroller.width: ShelfArrow {
            y: (parent.height - self.height) / 2;
            x: parent.width - self.width - 6px;
            forward: true;
            shelf-hover: shelf-ta.has-hover;
            clicked => { scroller.content-x -= scroller.width - 2 * Theme.body-gutter; }
        }
    }
}

// ---------------------------------------------------------------------------
// HomePage (HomePage.tsx)
// ---------------------------------------------------------------------------

export component HomePage inherits Rectangle {
    background: transparent;

    Flickable {
        width: 100%;
        height: 100%;
        content-height: content.preferred-height;
        content-width: self.width;

        content := VerticalLayout {
            spacing: 36px;
            padding-bottom: Theme.page-bottom-padding;

            // Page Header
            PageHeader { title: "Home"; }

            // 1. Top Picks for You
            if HomeData.top-picks.length > 0: TopPicksShelf { }

            // 2. Recently Played (TrackShelf)
            if HomeData.has-recently-played: ShelfView {
                shelf: HomeData.recently-played;
                play-shelf(shelf, item) => { HomeData.play-shelf(shelf, item); }
            }

            // 3. Lead dynamic shelf (Android / Web index 0)
            if HomeData.has-lead-shelf: ShelfView {
                shelf: HomeData.lead-shelf;
                play-shelf(shelf, item) => { HomeData.play-shelf(shelf, item); }
            }

            // 4. Find Your Mood
            MoodShelf { }

            // 5. Remaining dynamic shelves (indexes 1..N)
            for sh in HomeData.shelves: ShelfView {
                shelf: sh;
                play-shelf(shelf, item) => { HomeData.play-shelf(shelf, item); }
            }
        }
    }
}
