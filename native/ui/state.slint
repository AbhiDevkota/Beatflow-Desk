// The native shell's state, mirroring the Zustand stores the web shell reads
// (state/player.ts, state/ui.ts) plus the page models, as Slint globals.
//
// Shelf rendering follows web/app/src/components/shelf.ts's kinds:
//   layout 0 = square lockups (G), 1 = 4-row track columns (TrackLockupsShelf),
//   2 = artist circles (H), 3 = 16:9 videos (C).

export struct ShelfItem {
    title: string,
    subtitle: string,
    video-id: string,
    thumbnail: image,
    has-thumbnail: bool,
    // Artists render as circles (CircleLockup).
    round: bool,
    target-id: string,
    target-type: string, // "song", "album", "playlist", "artist"
}

// One fixed-height column of the `tracks` layout (ShelfColumn in Rust).
export struct ShelfColumn {
    items: [ShelfItem],
}

export struct Shelf {
    title: string,
    // Small line above the title ("GRAPE JUICE" on Listen again).
    strapline: string,
    layout: int,
    // Square / circle / video layouts.
    cards: [ShelfItem],
    // The `tracks` layout's fixed-height columns.
    columns: [ShelfColumn],
}

export struct MoodItem {
    key: string,
    title: string,
    background: color,
    stroke: color,
}

export struct SearchResult {
    title: string,
    artist: string,
    video-id: string,
    thumbnail: image,
    has-thumbnail: bool,
}

// A query completion from music/get_search_suggestions.
export struct SuggestionItem {
    text: string,
}

// A browse-category tile (CategoryTiles.tsx; the landing state of Search).
export struct CategoryItem {
    title: string,
    // The query the tile searches.
    query: string,
    base-color: color,
}

// Track row inside an album or playlist
export struct CollectionTrack {
    index: int,
    title: string,
    artist: string,
    duration: string,
    video-id: string,
    thumbnail: image,
    has-thumbnail: bool,
    explicit: bool,
    plays: string,
}

// Queue item
export struct QueueTrack {
    index: int,
    title: string,
    artist: string,
    duration: string,
    video-id: string,
    thumbnail: image,
    has-thumbnail: bool,
    active: bool,
}

// Lyrics line
export struct LyricsLine {
    text: string,
    active: bool,
}

// state/player.ts
export global Player {
    // nowPlaying
    in-out property <bool> has-track: true;
    in-out property <string> title: "";
    in-out property <string> artist: "";
    in-out property <image> artwork;
    in-out property <bool> has-artwork: false;

    // status: 0 = paused, 1 = playing, 2 = buffering/loading (BeatLoader)
    in-out property <int> status: 0;

    // progress is a 0..1 fraction of duration; elapsed is seconds.
    in-out property <float> progress: 0;
    in-out property <float> elapsed: 0;
    in-out property <float> duration: 0;

    // transport toggles
    in-out property <bool> shuffle: false;
    in-out property <int> repeat: 0; // 0 off, 1 all, 2 one
    in-out property <float> volume: 1;
    in-out property <bool> muted: false;
    in-out property <bool> has-next: true;

    // 0..1 phase of the BeatLoader
    in-out property <float> beat-phase: 0;

    callback toggle-play();
    callback next();
    callback previous();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback seeked(float);
    callback set-volume(float);
    callback toggle-mute();
    callback wheel-volume(float);
}

// state/ui.ts (shell-relevant slice)
export global Ui {
    in-out property <string> active-route: "Home";
    in-out property <string> previous-route: "Home";
    in-out property <bool> maximized: false;
    in-out property <string> side-panel: "";
    in-out property <bool> fullscreen-player: false;

    callback navigate-to(string);
    callback navigate-back();
    callback open-collection(string, bool); // id, is_album
    callback open-artist(string);
    callback toggle-fullscreen();
    callback close-fullscreen();
}

// search state (SearchPage.tsx)
export global Search {
    // Grouped results, in shelvesFor's order: Top Results + each shelf.
    in-out property <[SearchResult]> top-results;
    in-out property <[ShelfItem]> artists;
    in-out property <[ShelfItem]> albums;
    // The Songs group renders as the `tracks` layout (4-row columns).
    in-out property <Shelf> songs;
    in-out property <[ShelfItem]> playlists;
    // The Videos group renders as the `video` layout (16:9 lockups).
    in-out property <Shelf> videos;

    // The field's completions while typing (SearchField.tsx's useSuggestions).
    in-out property <[SuggestionItem]> suggestions;

    in-out property <string> query: "";
    callback search(string);
    callback suggest(string);
    callback play(SearchResult);
    callback play-shelf(Shelf, ShelfItem);
}

// Home page state (HomePage.tsx)
export global HomeData {
    in-out property <[ShelfItem]> top-picks;
    // The account's history renders as a `tracks` shelf (4-row columns).
    in-out property <Shelf> recently-played;
    in-out property <bool> has-recently-played: false;
    in-out property <[MoodItem]> moods;
    in-out property <Shelf> lead-shelf;
    in-out property <bool> has-lead-shelf: false;
    in-out property <[Shelf]> shelves;
    callback play(ShelfItem);
    callback play-shelf(Shelf, ShelfItem);
    callback play-mood(string);
}

// New / Explore page state (NewPage.tsx)
export global NewData {
    in-out property <[ShelfItem]> new-albums;
    in-out property <Shelf> top-charts;
    in-out property <[ShelfItem]> playlists;
    callback play(ShelfItem);
    callback play-shelf(Shelf, ShelfItem);
}

// Album & Playlist state (AlbumPage.tsx, PlaylistPage.tsx)
export global CollectionData {
    in-out property <string> id: "";
    in-out property <string> title: "";
    in-out property <string> subtitle: "";
    in-out property <string> byline: "";
    in-out property <string> description: "";
    in-out property <image> thumbnail;
    in-out property <bool> has-thumbnail: false;
    in-out property <bool> is-album: true;
    in-out property <[CollectionTrack]> tracks;
    in-out property <[Shelf]> more;
    in-out property <bool> loading: false;

    callback play-track(int);
    callback play-all();
    callback shuffle-all();
    callback back();
}

// Artist page state (ArtistPage.tsx)
export global ArtistData {
    in-out property <string> id: "";
    in-out property <string> name: "";
    in-out property <string> subscribers: "";
    in-out property <string> description: "";
    in-out property <image> banner;
    in-out property <bool> has-banner: false;
    in-out property <image> logo;
    in-out property <bool> has-logo: false;
    in-out property <[CollectionTrack]> top-songs;
    in-out property <[ShelfItem]> albums;
    in-out property <[ShelfItem]> singles;
    in-out property <[ShelfItem]> similar;
    in-out property <bool> loading: false;

    callback play-top(int);
    callback play-all();
    callback open-album(string);
    callback open-artist(string);
    callback back();
}

// Queue state for SidePanel drawer
export global QueueData {
    in-out property <[QueueTrack]> items;
    in-out property <int> current-index: 0;

    callback jump-to(int);
    callback clear();
}

// Lyrics state for SidePanel drawer
export global LyricsData {
    in-out property <[LyricsLine]> lines;
    in-out property <int> current-line: 0;
    in-out property <bool> has-lyrics: false;
}

// Downloads state (DownloadsPage.tsx)
export global DownloadsData {
    in-out property <[CollectionTrack]> tracks;
    in-out property <int> count: 0;
    in-out property <string> total-size: "0 MB";
    in-out property <bool> loading: false;

    callback play-track(int);
    callback play-all();
    callback shuffle-all();
    callback open-folder();
    callback refresh();
}

// Library state (LibraryPage.tsx)
export global LibraryData {
    in-out property <string> active-tab: "Playlists"; // "Playlists", "Albums", "Songs"
    in-out property <[ShelfItem]> playlists;
    in-out property <[ShelfItem]> albums;
    in-out property <[CollectionTrack]> songs;
    in-out property <bool> loading: false;

    callback set-tab(string);
    callback play-song(int);
    callback play-all();
    callback shuffle-all();
    callback refresh();
}

// Settings state (SettingsPage.tsx)
export global SettingsData {
    in-out property <string> active-category: "playback"; // "playback", "quality", "visuals", "storage", "about"
    in-out property <string> audio-quality: "High (256 kbps AAC)";
    in-out property <bool> animated-art: true;
    in-out property <bool> discord-rpc: true;
    in-out property <string> download-folder: "";
    in-out property <string> cache-size: "128 MB";
    in-out property <string> version: "BeatFlow Native 0.1.0";

    callback set-category(string);
    callback set-audio-quality(string);
    callback toggle-animated-art();
    callback toggle-discord-rpc();
    callback open-download-folder();
    callback clear-cache();
}
