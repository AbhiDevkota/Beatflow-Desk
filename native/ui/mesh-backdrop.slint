// Apple Music Ambient Mesh Backdrop, matching web/app/src/shell/MeshBackdrop.tsx.
// Deep velvety dark stage illuminated by current track's artwork with smooth cinematic gradients.

import { Theme } from "theme.slint";
import { Player } from "state.slint";

export component MeshBackdrop inherits Rectangle {
    background: #0a0a0c;
    clip: true;

    // Artwork bloom layer
    if Player.has-artwork: Image {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 120%;
        height: 120%;
        image-fit: cover;
        source: Player.artwork;
        opacity: 0.40;
    }

    // Secondary ambient tint layer
    Rectangle {
        width: 100%;
        height: 100%;
        background: @radial-gradient(circle, #ff2d5518 0%, #00000000 65%);
    }

    // Dark radial contrast mask
    Rectangle {
        width: 100%;
        height: 100%;
        background: @radial-gradient(circle, #00000020 0%, #00000099 100%);
    }

    // Top fade vignette
    Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 160px;
        background: @linear-gradient(180deg, #000000b0 0%, #00000040 50%, #00000000 100%);
    }

    // Bottom fade vignette
    Rectangle {
        x: 0;
        y: parent.height - self.height;
        width: 100%;
        height: 200px;
        background: @linear-gradient(0deg, #000000c0 0%, #00000050 50%, #00000000 100%);
    }
}
