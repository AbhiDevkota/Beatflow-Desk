// BeatFlow Icon Components

export component LogoMarkIcon inherits Image {
    source: @image-url("../assets/icons/logo-mark.svg");
    width: 22px;
    height: 22px;
}

export component PlayIcon inherits Image {
    in-out property <color> icon-color: #ffffff;
    source: @image-url("../assets/icons/play.svg");
    colorize: root.icon-color;
    width: 22px;
    height: 22px;
}

