// The app's icon set, extracted 1:1 from the web app's icon sources by
// native/tools/gen-icons.mjs (NavIcons.tsx, Transport.tsx, lucide, logo-mark).
// Every glyph is monochrome; `colorize` tints it at render time, which is how
// `fill="currentColor"` follows state colours in the React version.

import { Theme } from "theme.slint";

export component AppIcon inherits Rectangle {
    in property <image> source;
    in property <length> size: 24px;
    // `tint` rather than `color`: Rectangle already has a deprecated `color`
    // alias (for `background`), which can't be overridden.
    in property <color> tint: Theme.system-primary;

    width: root.size;
    height: root.size;
    background: transparent;

    Image {
        width: 100%;
        height: 100%;
        source: parent.source;
        colorize: parent.tint;
        image-fit: contain;
    }
}
